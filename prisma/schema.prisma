generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  HOST
  ADMIN
}

enum BookingStatus {
  pending
  accepted
  rejected
  cancelled
  completed
}

enum PaymentStatus {
  pending
  authorized
  paid
  failed
  refunded
}

enum BoatType {
  motorboot
  vissersboot
  sloep
  rib
  kajuitboot
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  passwordHash String
  role      UserRole   @default(GUEST)
  profile   Profile?
  listings  Listing[]  @relation("HostListings")
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]
  sentMessages Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Region {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String
  imageUrl    String
  listings    Listing[]
}

model Listing {
  id             String         @id @default(cuid())
  hostId         String
  host           User           @relation("HostListings", fields: [hostId], references: [id])
  regionId       String
  region         Region         @relation(fields: [regionId], references: [id])
  boat           Boat?
  title          String
  slug           String         @unique
  address        String
  city           String
  description    String
  latitude       Float
  longitude      Float
  pricePerNight  Int
  maxGuests      Int
  bedrooms       Int
  bathrooms      Int
  rating         Float          @default(0)
  reviewCount    Int            @default(0)
  popularity     Int            @default(0)
  petsAllowed    Boolean        @default(false)
  waterfront     Boolean        @default(false)
  privateDock    Boolean        @default(false)
  saunaHotTub    Boolean        @default(false)
  images         ListingImage[]
  bookings       Booking[]
  messages       Message[]
  reviews        Review[]
  favorites      Favorite[]
  amenities      Amenity[]      @relation("ListingAmenities")
  availableFrom  DateTime?
  availableUntil DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)
}

model Boat {
  id               String   @id @default(cuid())
  listingId        String   @unique
  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type             BoatType
  capacity         Int
  enginePowerHp    Int
  licenseRequired  Boolean
  safetyIncluded   Boolean  @default(true)
  description      String
}

model Booking {
  id             String        @id @default(cuid())
  listingId      String
  listing        Listing       @relation(fields: [listingId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  payment        Payment?
  messages       Message[]
  checkIn        DateTime
  checkOut       DateTime
  guests         Int
  status         BookingStatus @default(pending)
  totalPrice     Int
  message        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider       String
  providerRef    String?
  amount         Int
  currency       String        @default("EUR")
  status         PaymentStatus @default(pending)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([listingId, userId])
}

model Amenity {
  id       String    @id @default(cuid())
  name     String    @unique
  icon     String?
  listings Listing[] @relation("ListingAmenities")
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())
}
